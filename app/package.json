{
  "name": "gesi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "for f in src/lib/*.test.ts; do tsx \"$f\" || exit 1; done",
    "db:migrate": "prisma migrate dev",
    "demo:crear": "rm -f prisma/demo.db && DATABASE_URL=file:./prisma/demo.db prisma migrate deploy && DATABASE_URL=file:./prisma/demo.db tsx prisma/demo.ts",
    "demo": "DATABASE_URL=file:./prisma/demo.db GESI_DIST_DIR=.next-demo next dev -H 127.0.0.1 -p 3001"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.3",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
