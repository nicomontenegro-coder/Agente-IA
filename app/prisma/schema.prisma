// Base de datos de la app GESI, organizada por procesos.
// El diseño está en diseno/p2p.md, en la raíz del repositorio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ───────────────────────────── Datos que se reutilizan ─────────────────────────────

/// Datos de GESI para los documentos (RFQ y OC).
model Empresa {
  id        Int     @id @default(1)
  nombre    String  @default("GESI SpA")
  rut       String?
  direccion String?
  contacto  String?
  email     String?
  telefono  String?
  /// Garantía que se pide por defecto en las OC, en meses.
  garantiaMeses Int?
  /// Anticipo por defecto en pagos T/T, en % (se escribe 30, no 0,3).
  anticipoPct   Float @default(30)
}

/// Familia de productos: un proveedor trabaja una o varias.
/// Familia de productos, según UNSPSC a escala GESI: «Tuberías y fittings»
/// (4017), dentro del segmento 40. Los proveedores trabajan familias.
model Familia {
  id           String             @id @default(cuid())
  nombre       String             @unique
  segmento     String?
  codigoUnspsc String?
  productos    Producto[]
  proveedores  ProveedorFamilia[]
  clases       Clase[]
}

/// Clase de producto (Tubo, Fitting): productos que se describen con los mismos
/// atributos. Sus atributos son datos: se corrigen sin tocar el programa.
model Clase {
  id        String          @id @default(cuid())
  familiaId String
  familia   Familia         @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  nombre    String
  atributos ClaseAtributo[]
  productos Producto[]
  sinonimos ClaseSinonimo[]

  @@unique([familiaId, nombre])
}

/// Cómo escriben los proveedores cada tipo («Elbow reducer» = codo 90° con
/// diámetro 2). Es dato: se agrega sin programar. Valor vacío = no es de esta
/// clase (válvulas, llaves). Se prueban en orden de prioridad.
model ClaseSinonimo {
  id        String @id @default(cuid())
  claseId   String
  clase     Clase  @relation(fields: [claseId], references: [id], onDelete: Cascade)
  valor     String
  /// Expresión regular, sin distinguir mayúsculas.
  patron    String
  prioridad Int
}

model ClaseAtributo {
  id          String  @id @default(cuid())
  claseId     String
  clase       Clase   @relation(fields: [claseId], references: [id], onDelete: Cascade)
  posicion    Int
  clave       String
  nombre      String
  /// NUMERO, OPCION o TEXTO.
  tipo        String
  unidad      String?
  /// Para OPCION: los valores posibles, separados por coma.
  opciones    String?
  /// «tipo=reducción,tee»: solo aplica (y se exige) para esos tipos.
  soloSi      String?
  obligatorio Boolean @default(false)

  @@unique([claseId, clave])
}

model Producto {
  id             String   @id @default(cuid())
  codigo         String?
  nombre         String
  /// Medidas, material o norma: lo que hace que dos fábricas coticen lo mismo.
  especificacion String?
  unidad         String   @default("u")
  codigoHS       String?
  /// Certificación exigida en Chile para venderlo (por ejemplo, SEC).
  certificacionLocal String?
  familiaId      String?
  familia        Familia? @relation(fields: [familiaId], references: [id], onDelete: SetNull)
  /// Clase y modelo: «Fitting» › «Codo 90° PPR». El producto es la variante (la medida).
  claseId        String?
  clase          Clase?   @relation(fields: [claseId], references: [id], onDelete: SetNull)
  modelo         String?
  /// Valores de los atributos de la clase, en JSON: { "tipo": "codo 90°", "dn": 20 }.
  atributos      String?
  creadoEn       DateTime @default(now())
  lineas         CompraLinea[]
  ofertas        ListaPreciosItem[]
}

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String   @unique
  pais      String?
  contacto  String?
  email     String?
  telefono  String?
  /// WHATSAPP, ALIBABA, CORREO: por dónde se le escribe.
  canal     String   @default("CORREO")
  /// null = todavía no lo ha dicho. Si es false, queda eliminado en el primer embarque.
  aceptaCartaCredito Boolean?
  notas     String?
  creadoEn  DateTime @default(now())

  familias     ProveedorFamilia[]
  certificados Certificado[]
  invitaciones Invitacion[]
  listas       ListaPrecios[]
}

/// Tabla intermedia: qué familias trabaja cada proveedor (muchos a muchos).
model ProveedorFamilia {
  proveedorId String
  familiaId   String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  familia     Familia   @relation(fields: [familiaId], references: [id], onDelete: Cascade)

  @@id([proveedorId, familiaId])
}

model Certificado {
  id           String    @id @default(cuid())
  proveedorId  String
  proveedor    Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  /// CALIDAD, CUMPLIMIENTO o GESTION: cada tipo suma puntaje.
  tipo         String
  /// El nombre del certificado: ISO 9001, ISO 15874, CE…
  nombre       String
  vigenteHasta DateTime?
  creadoEn     DateTime  @default(now())
}

// ───────────────────────────── El proceso P2P ─────────────────────────────

/// Una compra: el proceso de principio a fin. Sabe en qué paso va.
model Compra {
  id        String   @id @default(cuid())
  /// Correlativo para el código GESI-CP12.
  numero    Int      @unique
  /// De qué se trata, en pocas palabras (también es el asunto de la RFQ).
  titulo    String
  incoterm  String   @default("FOB")
  /// Lugar del incoterm que se pide (por ejemplo, el puerto de carga).
  lugar     String?
  /// Destino final: San Antonio, Punta Arenas…
  destino   String?
  plazoRespuesta DateTime?
  /// La etapa decidida a mano. La que se muestra se despeja de lo registrado.
  etapa     String   @default("NECESIDAD")
  /// Por qué se canceló o se corrigió hacia atrás.
  nota      String?
  /// Medida para comparar ofertas que cada proveedor cubica distinto:
  /// 722 m² de un galpón, 3.000 m de tubería. Con ella sale «US$ por m²».
  medidaRef Float?
  unidadRef String?
  creadoEn  DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  lineas       CompraLinea[]
  invitaciones Invitacion[]
  ordenes      OrdenCompra[]
}

/// Un producto pedido en una compra, con su cantidad.
model CompraLinea {
  id         String    @id @default(cuid())
  compraId   String
  compra     Compra    @relation(fields: [compraId], references: [id], onDelete: Cascade)
  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  /// Como se le describe al proveedor, en inglés.
  descripcion    String
  especificacion String?
  cantidad   Float
  unidad     String
  orden      Int       @default(0)

  precios CotizacionLinea[]
}

/// La RFQ enviada a un proveedor. Una compra invita a varios.
model Invitacion {
  id          String    @id @default(cuid())
  compraId    String
  compra      Compra    @relation(fields: [compraId], references: [id], onDelete: Cascade)
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  enviadaEl   DateTime?
  /// El proveedor dijo que no cotiza.
  declino     Boolean   @default(false)
  creadoEn    DateTime  @default(now())

  cotizacion Cotizacion?

  @@unique([compraId, proveedorId])
}

/// La respuesta de un proveedor a una invitación.
model Cotizacion {
  id           String     @id @default(cuid())
  invitacionId String     @unique
  invitacion   Invitacion @relation(fields: [invitacionId], references: [id], onDelete: Cascade)
  recibidaEl   DateTime   @default(now())
  /// Número o referencia del documento del proveedor.
  referencia   String?
  moneda       String     @default("USD")
  incoterm     String
  lugar        String?
  leadTimeDias Int?
  validezDias  Int?
  moq          String?
  /// Lo que dijo el proveedor en esta cotización; también actualiza su ficha.
  aceptaCartaCredito Boolean?
  notas        String?
  /// El PDF del proveedor, guardado en la carpeta de documentos.
  archivo       String?
  archivoNombre String?
  /// Lo que dice el documento, para comprobar que las cuentas cuadran.
  subtotalDocumento Float?
  /// Gastos aparte hasta FOB (flete interno, despacho), si cotiza EXW + gastos.
  gastosDocumento   Float?
  totalDocumento    Float?

  lineas   CotizacionLinea[]
  desglose CotizacionDesglose[]
  ordenes  OrdenCompra[]
}

/// El detalle con que el proveedor arma su precio (su cubicación). Se guarda
/// aparte de las líneas de la compra: cada proveedor cubica distinto, y lo que
/// se compara y se compra es lo que pidió GESI, no su lista de piezas.
model CotizacionDesglose {
  id             String     @id @default(cuid())
  cotizacionId   String
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  posicion       Int
  descripcion    String
  unidad         String?
  cantidad       Float?
  precioUnitario Float?
  monto          Float?
}

/// Lo que leyó la IA de un PDF, esperando que una persona lo revise. Se borra
/// al guardar la cotización: la IA propone, no guarda.
model LecturaPendiente {
  id            String   @id @default(cuid())
  compraId      String?
  /// Null mientras no se sabe de qué proveedor es: se sube el PDF primero y
  /// el proveedor se elige después, con lo que leyó la IA.
  invitacionId  String?
  archivo       String
  archivoNombre String
  /// La lectura completa en JSON (null si no hubo lector y solo se adjuntó el PDF).
  lectura       String?
  error         String?
  creadoEn      DateTime @default(now())
}

/// El precio de una línea de la compra en una cotización (tabla intermedia con datos).
model CotizacionLinea {
  id            String      @id @default(cuid())
  cotizacionId  String
  cotizacion    Cotizacion  @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  compraLineaId String
  compraLinea   CompraLinea @relation(fields: [compraLineaId], references: [id], onDelete: Cascade)
  precioUnitario Float?

  @@unique([cotizacionId, compraLineaId])
}

/// La orden de compra. Copia los precios: lo decidido se congela.
model OrdenCompra {
  id           String     @id @default(cuid())
  /// Correlativo para el código GESI-OC7.
  numero       Int        @unique
  compraId     String
  compra       Compra     @relation(fields: [compraId], references: [id], onDelete: Cascade)
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id])
  fecha        DateTime   @default(now())
  moneda       String
  incoterm     String
  lugar        String?
  destino      String?
  consignatario String?
  /// Fecha de embarque comprometida (ETD).
  etd          DateTime?
  /// CARTA_CREDITO o TT.
  formaPago    String
  anticipoPct  Float?
  descuentoPct Float?
  garantiaMeses Int?
  /// Una OC no se borra: se anula, y conserva su número.
  anuladaEl       DateTime?
  motivoAnulacion String?
  creadoEn     DateTime   @default(now())

  lineas OrdenLinea[]
  pagos  Pago[]
}

/// Una línea de la orden, con descripción y precio copiados de la cotización.
model OrdenLinea {
  id             String      @id @default(cuid())
  ordenId        String
  orden          OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  /// De qué línea de la compra viene: trazabilidad, el precio igual se copia.
  compraLineaId  String?
  codigo         String?
  descripcion    String
  especificacion String?
  cantidad       Float
  unidad         String
  precioUnitario Float
  posicion       Int         @default(0)
}

/// Un pago de la orden: carta de crédito, anticipo o saldo.
model Pago {
  id      String      @id @default(cuid())
  ordenId String
  orden   OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  /// CARTA_CREDITO, ANTICIPO o SALDO.
  tipo    String
  monto   Float?
  fecha   DateTime    @default(now())
  nota    String?
}

/// Correlativos de los códigos GESI.
model Correlativo {
  tipo  String @id
  ultimo Int   @default(0)
}

// ───────────────────────────── Listas de precios ─────────────────────────────

/// La lista de precios general de un proveedor (su catálogo), tal como la
/// mandó: no responde a una compra. Alimenta el costo estimado y la lista de
/// venta. Se guarda con su fecha y validez: vencida no se borra, porque dice
/// con qué precios se decidió.
model ListaPrecios {
  id            String   @id @default(cuid())
  proveedorId   String
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  archivo       String
  archivoNombre String
  fecha         DateTime
  validezDias   Int?
  moneda        String   @default("USD")
  incoterm      String?
  lugar         String?
  /// Lo que la lectura no pudo leer con seguridad.
  notas         String?
  creadoEn      DateTime @default(now())

  items  ListaPreciosItem[]
  ventas ListaVenta[]
}

model ListaPreciosItem {
  id             String       @id @default(cuid())
  listaId        String
  lista          ListaPrecios @relation(fields: [listaId], references: [id], onDelete: Cascade)
  posicion       Int
  /// Familia amplia para el costo logístico: tubería, fitting, válvula…
  familia        String
  /// La sección del documento: «PPR cold & hot water pipe», «45° Elbow».
  grupo          String?
  descripcion    String
  especificacion String?
  unidad         String
  /// Null si la lista deja la celda en blanco (se cotiza a pedido).
  precio         Float?
  /// Presión nominal según la norma indicada, por ejemplo «PN16 (DIN 8077)».
  pn             String?
  /// Equivalencia: el producto GESI que es este ítem del proveedor.
  productoId     String?
  producto       Producto?    @relation(fields: [productoId], references: [id], onDelete: SetNull)
}

/// Una lista de venta (por ejemplo, la preventa de un embarque) armada desde
/// una lista del proveedor. Lo decidido se congela: guarda su tipo de cambio,
/// sus factores y sus márgenes.
model ListaVenta {
  id             String       @id @default(cuid())
  listaPreciosId String
  listaPrecios   ListaPrecios @relation(fields: [listaPreciosId], references: [id], onDelete: Cascade)
  titulo         String
  /// Pesos por dólar con que se calcularon los precios.
  tipoCambio     Float?
  /// Costo puesto en bodega ÷ FOB, uno para toda la lista.
  factor         Float?
  /// De dónde salió el factor: «costeo de octubre, Excel», «GESI-C12 de Importa».
  factorOrigen   String?
  /// Margen que nunca se cruza al dar descuentos, en %: fija el precio mínimo.
  margenMinimoPct Float?
  entrega        String?
  condiciones    String?
  validezDias    Int?
  creadoEn       DateTime     @default(now())
  actualizadoEn  DateTime     @updatedAt

  familias ListaVentaFamilia[]
  canales  ListaVentaCanal[]
}

/// Un canal de venta con su descuento sobre el precio de lista: ferreterías
/// −30%, instaladores −15%. No puede dejar el margen bajo el mínimo.
model ListaVentaCanal {
  id           String     @id @default(cuid())
  listaVentaId String
  listaVenta   ListaVenta @relation(fields: [listaVentaId], references: [id], onDelete: Cascade)
  posicion     Int
  canalId      String
  canal        CanalVenta @relation(fields: [canalId], references: [id])
  descuentoPct Float

  @@unique([listaVentaId, canalId])
}

model ListaVentaFamilia {
  id           String     @id @default(cuid())
  listaVentaId String
  listaVenta   ListaVenta @relation(fields: [listaVentaId], references: [id], onDelete: Cascade)
  familia      String
  /// Margen sobre el precio de venta, en %. Sin margen, la familia no se ofrece.
  margenPct    Float?
  /// Cómo se vende si no es en la unidad del proveedor: «tira de 4 m».
  unidadVenta  String?
  /// Cuántas unidades del proveedor trae una unidad de venta: 4 (metros por tira).
  contenido    Float?

  @@unique([listaVentaId, familia])
}

// ───────────────────────────── Asistente ─────────────────────────────

/// La conversación con el asistente, por pantalla: «lista:<id>» es la de una
/// lista de precios. Se guarda para que el asistente recuerde lo hablado.
model ChatMensaje {
  id       String   @id @default(cuid())
  contexto String
  /// USUARIO o ASISTENTE.
  rol      String
  texto    String
  creadoEn DateTime @default(now())

  @@index([contexto, creadoEn])
}

/// Un cambio que propuso el asistente. No se aplica hasta que Nico lo aprueba.
model Propuesta {
  id          String   @id @default(cuid())
  contexto    String
  descripcion String
  /// Los cambios en JSON: [{ itemId, campo, valor, antes }].
  cambios     String
  /// PENDIENTE, APLICADA o DESCARTADA.
  estado      String   @default("PENDIENTE")
  creadoEn    DateTime @default(now())
  resueltaEn  DateTime?
}

// ───────────────────────────── Clientes ─────────────────────────────

/// Canal de venta: ferreterías, instaladores, constructoras… Es dato: se
/// agrega o renombra sin programar. El cliente pertenece a un canal, y cada
/// lista de venta fija el descuento de cada canal.
model CanalVenta {
  id        String            @id @default(cuid())
  nombre    String            @unique
  posicion  Int               @default(0)
  clientes  Cliente[]
  descuentos ListaVentaCanal[]
}

/// Un cliente o prospecto. Se identifica por su RUT (único); el nombre puede
/// escribirse de muchas formas y no lo identifica.
model Cliente {
  id            String      @id @default(cuid())
  nombre        String
  rut           String?     @unique
  canalId       String?
  canal         CanalVenta? @relation(fields: [canalId], references: [id], onDelete: SetNull)
  /// Contacto principal de la empresa; cada sucursal tiene además el suyo.
  contacto      String?
  telefono      String?
  email         String?
  notas         String?
  /// Embudo (src/lib/embudo.ts): IDENTIFICADO … GANADO, PERDIDO.
  etapa         String      @default("IDENTIFICADO")
  /// Lo que hay que hacer con él, y cuándo. Sin esto un prospecto se enfría solo.
  proximaAccion String?
  proximaFecha  DateTime?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
  gestiones     Gestion[]
  sucursales    Sucursal[]
}

/// Un local del cliente: dónde se entrega y con quién se habla ahí. La empresa
/// (el cliente) decide la compra; la sucursal es el lugar.
model Sucursal {
  id        String    @id @default(cuid())
  clienteId String
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ciudad    String
  direccion String?
  contacto  String?
  telefono  String?
  creadoEn  DateTime  @default(now())
  gestiones Gestion[]
}

/// Lo que pasó con un cliente: una visita, una llamada, un cambio de etapa.
/// El historial del embudo: cada cambio de etapa queda aquí con su motivo.
model Gestion {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// En qué local fue, si fue en uno.
  sucursalId String?
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  fecha     DateTime @default(now())
  /// VISITA, LLAMADA, WHATSAPP, CORREO, REUNION, NOTA (src/lib/embudo.ts).
  medio     String
  texto     String
  etapaDe   String?
  etapaA    String?
  creadoEn  DateTime @default(now())

  @@index([clienteId, fecha])
}
